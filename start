#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * loongs console entry (symfony/console via Loongs\Console\Kernel).
 *
 *   ./start                         start (foreground; -d to daemonize)
 *   ./start start|stop|restart|reload|status [--only=http,rpc]
 *   ./start rpc:show|rpc:switch|rpc:set|rpc:reset ...   RPC hot switch (no restart)
 *   ./start list | ./start help <command>
 */
if (!defined('LOONGS_BASE_PATH')) {
    define('LOONGS_BASE_PATH', __DIR__);
}

$autoload = LOONGS_BASE_PATH . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Autoloader not found. Run: composer update\n");
    exit(1);
}

require $autoload;

exit((new Loongs\Console\Kernel(LOONGS_BASE_PATH))->run());
