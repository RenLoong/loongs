{
    "name": "loongs/loongs",
    "description": "loong-swoole HTTP server application",
    "type": "project",
    "license": "MIT",
    "require": {
        "loongs/framework": "dev-main",
        "loongs/helper": "dev-main",
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "apps/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php bin/publish-loongs-configs.php"
        ]
    }
}
